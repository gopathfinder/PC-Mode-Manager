{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PC Mode Manager",
  "version": "1.2.0",
  "identifier": "com.pcmodemanager.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PC Mode Manager",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "PC Mode Manager for Windows",
    "longDescription": "PC Mode Manager with Windows process management, system monitoring and automated profiles."
  }
}